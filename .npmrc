# The @stackmyth/* UI packages are published privately to GitHub Packages, not
# npmjs. Without this scope mapping, `npm install` fails on a fresh clone and in
# CI/Vercel builds.
#
# The token itself is NEVER committed — it is read from the NODE_AUTH_TOKEN
# environment variable. Generate one at GitHub → Settings → Developer settings →
# Personal access tokens (classic) with the `read:packages` scope, then:
#
#   export NODE_AUTH_TOKEN=ghp_...        (locally)
#   Settings → Environment Variables      (on Vercel)
@stackmyth:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
