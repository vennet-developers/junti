# ─────────────────────────────────────────────────────────────────────────────
# Database — Supabase is managed Postgres here, and nothing more.
#
# No Supabase data client, no RLS, no service-role key: every read and write in
# this project goes through Drizzle over a plain Postgres connection, and access
# control is token-based, enforced in server actions. Supabase Auth appears at
# the bottom of this file, for optional organizer sign-in — identity only, never
# data.
#
# Everything in THIS section is a SERVER-SIDE SECRET: never prefix any of it
# with NEXT_PUBLIC_.
#
# Copy this file to .env.local and fill it in. Find the values in the Supabase
# dashboard under: Project Settings → Database → Connection string, with
# "Display connection pooler" ticked.
# ─────────────────────────────────────────────────────────────────────────────


# ── Recommended: discrete fields ─────────────────────────────────────────────
#
# The password is used VERBATIM — no percent-encoding, ever, whatever characters
# it contains. That is the whole reason this form is preferred: Supabase
# generates passwords containing @ # and %, and a connection URI reserves all
# three (see the alternative at the bottom).
#
# Rotating the password means pasting the new one here and nothing else.

DB_HOST="aws-0-REGION.pooler.supabase.com"
DB_USER="postgres.YOUR_PROJECT_REF"
DB_PASSWORD="paste-it-raw-do-not-escape"
DB_NAME="postgres"

# Transaction pooler. What the running app uses.
#
# Vercel spins up many short-lived function instances and Supabase's direct
# connection limit is small, so runtime traffic must go through the pooler.
# Transaction mode has no prepared statements, which is why the driver sets
# `prepare: false` (src/db/client.ts) — omitting that produces intermittent
# failures under concurrency that look exactly like application bugs.
DB_PORT="6543"

# Session mode. Migrations and pg_dump only — never used at runtime.
# DDL and pg_dump need session state the transaction pooler cannot hold.
DB_DIRECT_PORT="5432"

# Optional. Defaults to "require" for remote hosts and off for localhost.
# DB_SSL="require"


# ── Alternative: a single connection string ──────────────────────────────────
#
# Supported for platforms that only hand you one URL. Use EITHER this OR the
# discrete fields above; if both are present, the fields win.
#
# ⚠ A URI reserves @ # % : / and ?, so a password containing any of them MUST be
#   percent-encoded or the string silently parses into the wrong host and fails
#   with a confusing authentication error. To encode one:
#
#     node -e 'console.log(encodeURIComponent(process.argv[1]))' '<password>'
#
#   The discrete fields above exist precisely to avoid this.
#
# DATABASE_URL="postgresql://postgres.REF:PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"


# ─────────────────────────────────────────────────────────────────────────────
# Supabase Auth — organizer accounts (Google SSO + email magic link)
#
# These two ARE public, unlike everything above. Next.js inlines NEXT_PUBLIC_*
# into the browser bundle by design. The publishable key identifies the project
# and nothing more: it grants no data access here, because Supabase is used for
# AUTHENTICATION ONLY — every read and write still goes through Drizzle from
# server code. See DECISIONS.md, "Supabase Auth for identity, Drizzle for data".
#
# Find them in: Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Email ────────────────────────────────────────────────────────────────────
# Leave EMAIL_PROVIDER unset and the app sends nothing: the console adapter
# logs what it would have sent. That is the default on purpose — development
# and staging cannot reach a real person without an explicit act.
#
# To send for real, name a provider and give it its key. Adding another means
# an adapter file and a case in src/lib/email/provider.ts; nothing else changes.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# Per environment, so a mistake here cannot spend production's reputation:
# EMAIL_FROM="Junti <hola@mail.junti.app>"

# Quién puede abrir /funnel. El id de cuenta del responsable, nada más.
# Sin valor = nadie: una variable ausente nunca debe ampliar el acceso.
ANALYTICS_OWNER_ID=
